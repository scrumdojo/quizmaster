{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/lint.sh\"",
            "statusMessage": "Linting changed file..."
          }
        ]
      }
    ]
  }
}
